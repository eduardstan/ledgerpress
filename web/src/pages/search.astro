---
import PageHead from '../components/PageHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalUrl } from '../lib/urls';

// Pagefind indexes `dist/` after `astro build` (see the `build` script) and
// writes its runtime to `/pagefind/`. Those files only exist in a built site,
// so search works under `astro preview` but not under `astro dev`. The tags
// below are `is:inline` for the same reason: Vite must not try to resolve them
// at build time.
const base = import.meta.env.BASE_URL;
const url = (path: string) => internalUrl(path, base);
---

<BaseLayout title="Search" description="Search this site.">
  <link slot="head" rel="stylesheet" href={url('/pagefind/pagefind-component-ui.css')} />
  <script
    slot="head"
    is:inline
    type="module"
    src={url('/pagefind/pagefind-component-ui.js')}
  ></script>
  <PageHead title="Search" />
  <div class="single mt-6" data-pagefind-ignore>
    {
      base !== '/' && (
        <pagefind-config bundle-path={url('/pagefind/')} base-url={base}></pagefind-config>
      )
    }
    <pagefind-searchbox></pagefind-searchbox>
  </div>
  <noscript>
    <p class="single mt-4 text-muted">Search requires JavaScript.</p>
  </noscript>
</BaseLayout>
