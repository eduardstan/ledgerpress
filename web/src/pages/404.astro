---
import PageHead from '../components/PageHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { internalUrl } from '../lib/urls';

const url = (path: string) => internalUrl(path, import.meta.env.BASE_URL);
---

<BaseLayout title="404 — Page not found">
  <PageHead title="404" />
  <div class="prose single">
    <p>
      That page does not exist. Try the <a href={url('/')}>home page</a> or <a
        href={url('/search/')}>search</a
      >.
    </p>
  </div>
</BaseLayout>
