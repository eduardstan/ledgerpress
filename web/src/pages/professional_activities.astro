---
/**
 * Editorial, committee and reviewing service, rendered from `content/cv.yaml`'s
 * `service[]` — the same list the printed CV is generated from.
 *
 * The Jekyll site kept its own copy of these facts in a hand-written page. It
 * was a third transcription of one list, it had drifted from the file the CV is
 * built from, and it is gone. `service[]` is the record.
 *
 * Entries are grouped by `title` in the order the roles first appear in the
 * file, so the grouping is the file's own and not an ordering invented here.
 * Nothing is filtered: every entry in `service[]` is on this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Record from '../components/Record.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  countPhrase,
  CV_SOURCE,
  editionYear,
  keysOf,
  service,
  serviceGroups,
  type Entry,
} from '../lib/cv';
import { inline } from '../lib/inline';
import { internalUrl } from '../lib/urls';

// The same grouping the home page's service column uses, so the two pages
// cannot disagree about a list they both read from `service[]`.
const roles = service();
const groups = serviceGroups();
const base = import.meta.env.BASE_URL;
const url = (path: string) => internalUrl(path, base);
const render = (text: string | undefined) => inline(text, base);

/** The editions an entry records, as the years the file lists. */
const editions = (entry: Entry) => (entry.years ?? []).map(editionYear).join(', ');

/** Entries with no term and no editions, so nothing to print in the date column. */
const noTerm = roles.filter((entry) => !entry.dates && !entry.years?.length);
/** Of those, the ones whose only date at all is the day the invitation landed. */
const announcedOnly = noTerm.filter((entry) => entry.announced);
/** And the ones the file gives no date of any kind. */
const dateless = noTerm.filter((entry) => !entry.announced);
const ranked = roles.filter((entry) => entry.metric);
const linkedRanks = roles.filter((entry) => entry.rank_url);
const venues = new Set(roles.map((entry) => entry.org)).size;
const roleEntries = countPhrase(roles.length);
const roleGroups = countPhrase(groups.length, 'role');

const description =
  `Editorial boards, conference committees and journal reviewing — ` +
  `${countPhrase(roles.length, 'role').text} at ${countPhrase(venues, 'venue').text}, ` +
  `read from ${CV_SOURCE} at build time.`;
---

<BaseLayout title="Professional activities" description={description}>
  <PageHead title="Professional activities">
    <p class="blurb">
      <b>{countPhrase(roles.length, 'service role').text}</b>, grouped by role and read from <b
        >{CV_SOURCE}</b
      > when this page was built — the same file the printed CV is generated from. Where the file
      records a ranking it also records where that ranking is published, so every badge below links
      to the CORE portal or SCImago entry behind it. Turn <b>inspect sources</b> on, in the bar above,
      to see what each section is built from.
    </p>
  </PageHead>

  {
    groups.map((group) => (
      <>
        <SectionHead source={`${CV_SOURCE} · service[] · role: ${group.role}`}>
          {group.role}
        </SectionHead>
        <ul class="rows">
          {group.entries.map((entry) => (
            <li>
              <span class="k">
                {entry.url ? (
                  <a href={url(entry.url)} set:html={render(entry.org)} />
                ) : (
                  <Fragment set:html={render(entry.org)} />
                )}
                {entry.metric &&
                  (entry.rank_url ? (
                    <a
                      class="rank"
                      href={url(entry.rank_url)}
                      set:html={render(entry.metric)}
                    />
                  ) : (
                    <span class="rank" set:html={render(entry.metric)} />
                  ))}
                {entry.detail && <span class="sub" set:html={render(entry.detail)} />}
              </span>
              <span class="v">
                {entry.items && (
                  <ul>
                    {entry.items.map((item) => (
                      <li set:html={render(item)} />
                    ))}
                  </ul>
                )}
              </span>
              <span class="when">
                {entry.dates ? <Fragment set:html={render(entry.dates)} /> : editions(entry)}
              </span>
            </li>
          ))}
        </ul>
        <Record>
          <p>
            <b>{CV_SOURCE}</b> — the {group.entries.length} <b>service[]</b>{' '}
            {countPhrase(group.entries.length).words} whose <b>title</b> is “{group.role}”,
            in file order. Keys read: {keysOf(group.entries)}.
            {group.entries.some((entry) => entry.years?.length) && (
              <>
                {' '}
                The right-hand column is <b>dates</b> where the entry states a term and the years of{' '}
                <b>years[]</b> where it states editions ({group.entries
                  .filter((entry) => entry.years?.length)
                  .map((entry) => editions(entry))
                  .join('; ')}
                ).
              </>
            )}
          </p>
        </Record>
      </>
    ))
  }

  <Record>
    <p>
      <b>{CV_SOURCE}</b> — <b>service[]</b>, {
        countPhrase(roles.length, 'entry grouped', 'entries grouped').text
      } into {roleGroups.text} ({
        groups.map((group) => `${group.role}: ${group.entries.length}`).join(', ')
      }). The grouping is by the <b>title</b> field and the order is the order those roles first
      appear in the file; no entry is filtered out and none is relabelled.
    </p>
    <p>
      {
        countPhrase(
          ranked.length,
          `of ${roleEntries.text} carries`,
          `of ${roleEntries.text} carry`,
        ).text
      } a <b>metric</b>, and {
        countPhrase(linkedRanks.length, 'carries', 'carry').text
      } the <b>rank_url</b> the badge links to. The badge text is the <b>metric</b> field verbatim — “{
        [...new Set(ranked.map((entry) => entry.metric))].join('”, “')
      }” — not a rank computed here.
    </p>
    <p>
      {countPhrase(noTerm.length, 'entry states', 'entries state').text} neither <b>dates</b> nor{' '}
      <b>years[]</b>, so the column on the right is empty for them. {
        countPhrase(announcedOnly.length, 'of those carries', 'of those carry').text
      } an <b>announced</b> day ({
        announcedOnly.map((entry) => entry.org).join('; ')
      }), which is the date the <a href={url('/lately/')}>register</a> announces the invitation on —
      the day it was accepted, not a term of service, so it is not printed here as one. The remaining
      {
        countPhrase(
          dateless.length,
          `entry carries no date of any kind (${dateless.map((entry) => entry.org).join('; ')}), and is shown undated rather than given a year the file does not state`,
          `entries carry no date of any kind (${dateless.map((entry) => entry.org).join('; ')}), and are shown undated rather than given a year the file does not state`,
        ).text
      }.
    </p>
  </Record>
</BaseLayout>
