---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { identity, profile } from '../lib/record';
import { absoluteInternalUrl, internalUrl } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  /**
   * Where this page's content really lives, when it is an alternate view of
   * another page. One `<link rel="canonical">` is emitted either way: a second,
   * conflicting one would make search engines ignore both. Alternate views
   * leave Open Graph and Twitter metadata to the canonical page.
   */
  canonical?: string;
  /** Keeps the page out of the Pagefind index — `<main>` is the indexed body. */
  noindex?: boolean;
}

const { name } = profile();
const base = import.meta.env.BASE_URL;
const { favicon, portrait } = identity(base);
const {
  title,
  description = `Personal site of ${name}.`,
  canonical: canonicalPath,
  noindex = false,
} = Astro.props;
const canonical = canonicalPath ? absoluteInternalUrl(canonicalPath, Astro.site!, base) : Astro.url;
const url = (path: string) => internalUrl(path, base);
/** Anything below `/blog/` is one post; the `/blog/` index itself is not. */
const isPost = /\/blog\/./.test(canonical.pathname);
const socialImageUrl =
  portrait && /\.(?:png|jpe?g|webp)$/i.test(portrait)
    ? new URL(portrait, Astro.site!).href
    : undefined;
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      canonicalPath === undefined && (
        <>
          <meta property="og:type" content={isPost ? 'article' : 'website'} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical.href} />
          <meta property="og:site_name" content={name} />
          <meta name="twitter:card" content="summary" />
          {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
          {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
        </>
      )
    }
    {favicon && <link rel="icon" href={favicon} />}
    <link rel="alternate" type="application/rss+xml" title={name} href={url('/rss.xml')} />
    {
      /* The masthead face and the body face are needed for first paint; the
         other four load as the page uses them. */
    }
    <link
      rel="preload"
      href={url('/fonts/Archivo-Black.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={url('/fonts/LedgerSerif-Regular.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body>
    {
      /* Outside `.wrap` so it stays the first thing a keyboard reaches, ahead of
         the inspect switch below. */
    }
    <a class="skip label" href="#main">Skip to content</a>
    {
      /* The inspect switch. A native checkbox, so it is keyboard-operable,
         announces its own state and needs no JavaScript. It must stay a sibling
         of `.wrap`: every reveal in global.css is a `#inspect:checked ~ .wrap`
         rule. Its label sits in the header. */
    }
    <input type="checkbox" id="inspect" class="vh" data-pagefind-ignore />
    <div class="wrap">
      <Header />
      <main id="main" data-pagefind-body={noindex ? undefined : true}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
